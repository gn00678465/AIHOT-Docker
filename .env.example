# ===== 必填基本設定 =====

# 網站對外的實際訪問位址（請改成 Unraid 區域網路 IP 或對外反向代理網址）
SITE_URL=http://192.168.1.xxx:3000

# 外部映射端口（預設 3000）
PORT=3000

# 管理員登入密碼（至少 12 位，請自訂複雜密碼）
ADMIN_PASSWORD=change_this_password_123456

# 會話簽名與圖片代理密鑰（可使用 openssl rand -hex 32 生成，或填寫任意隨機 32 位以上字串）
SESSION_SECRET=c259d5f25f2b2a7cd198c3a67632662862fcf6b7a6e4983ccf7d4b94911adb57
IMG_PROXY_SIGN_SECRET=6106acef5486e10d6d1fba0964cce5579f3259d61fbfc8dc1b750992e5ee6303

# PostgreSQL 資料庫密碼（不對外開放端口）
POSTGRES_PASSWORD=3d7a70719431a81755515f7e96e574f5da29

# ===== 模型設定（原生支援 Anthropic Messages API 與 OpenAI 兼容接口） =====

# --- [選項 A] Anthropic 官方 Messages API 直連（推薦您使用）---
LLM_BASE_URL=https://api.anthropic.com
LLM_API_KEY=sk-ant-api03-你的Anthropic金鑰
LLM_MODEL=claude-3-5-sonnet-20241022
# 若追求省額度也可以換成 Haiku:
# LLM_MODEL=claude-3-haiku-20240307

# --- [選項 B] DeepSeek 官方端點（若改用 DeepSeek 請切換為這組）---
# LLM_BASE_URL=https://api.deepseek.com/v1
# LLM_API_KEY=your_deepseek_key
# LLM_MODEL=deepseek-chat
# LLM_EXTRA_JSON={"thinking":{"type":"disabled"}}

# ===== 安全閥開關（正式啟用請設小寫 true） =====
# 是否開啟自動抓取信源
COLLECT_ENABLED=true

# 是否開啟模型調用（AI 評分、新聞摘要、結構化提取等）
MODEL_CALLS_ENABLED=true

# ===== 內網與代理選填 =====
# 若抓取同主機上的 RSSHub，填寫主機名稱或內網 IP 放行內網連線：
# PRIVATE_FEED_HOSTS=rsshub,192.168.1.xxx

# 海外抓取代理（選填）
# EGRESS_PROXY_URL=http://192.168.1.xxx:7890
